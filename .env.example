# Run `garmin-mcp-auth` once with these set; afterwards the server uses cached tokens.
GARMIN_EMAIL=yash.hooda6@gmail.com
GARMIN_PASSWORD=Yhrunner#1

# Where long-lived tokens are cached (treat as a secret). Default: ~/.garminconnect
GARMINTOKENS=./.garminconnect

# Transport: stdio (Claude Desktop / local) | streamable-http (remote, e.g. Railway)
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# REQUIRED before exposing the HTTP transport publicly. Generate with:
#   openssl rand -hex 32
# Clients must then send:  Authorization: Bearer <this value>
MCP_AUTH_TOKEN=
